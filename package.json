{
  "name": "edi-insight",
  "displayName": "EDI Insight",
  "description": "Analyze and visualize EDI payment/remittance messages with business-friendly explanations. 100% offline — no data leaves your machine.",
  "version": "0.1.4",
  "publisher": "fattahpour",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "EDI",
    "X12",
    "820",
    "835",
    "remittance",
    "payment",
    "ACH",
    "healthcare",
    "offline"
  ],
  "galleryBanner": {
    "color": "#0b5cad",
    "theme": "dark"
  },
  "homepage": "https://github.com/fattahpour/vscode-edi-insight#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fattahpour/vscode-edi-insight.git"
  },
  "bugs": {
    "url": "https://github.com/fattahpour/vscode-edi-insight/issues"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "edi",
        "aliases": [
          "EDI",
          "X12"
        ],
        "extensions": [
          ".edi",
          ".x12"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "edi",
        "scopeName": "source.edi",
        "path": "./syntaxes/edi.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ediInsight.analyze",
        "title": "EDI Insight: Analyze Current File"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ediInsight.analyze",
          "when": "resourceExtname =~ /\\.(edi|x12|txt)$/"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test ./out/test/*.test.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
